function getSharedPrintLotusUrl() {
  if (!SHARED_PRINT_LOTUS_URL) {
    const b64 = SHARED_PRINT_LOTUS.split(',')[1];
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);

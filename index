    function addSharedPrintWatermark(html) {
      // Keep the embedded apps self-contained when the hub is opened as a local HTML file.
      // Using the embedded data URL avoids failures from URL.createObjectURL in restricted browsers.
      return String(html || '').split('__SCHOOL_HUB_LOTUS_URL__').join(UNIVERSE === 'hostel' ? HOSTEL_PRINT_LOTUS : SHARED_PRINT_LOTUS);
    }

    // ---------------------------------------------------------------------
    // HOSTEL FILE STORAGE ISOLATION SHIM
    // ---------------------------------------------------------------------
    // The Hostel universe is a linked copy of the School universe:
    //   - Any data change made in School.html shows up in this Hostel copy
    //     the moment a screen here is opened or re-read (since, by default,
    //     every read here simply looks at School's live saved data).
    //   - Any change made from WITHIN this Hostel copy is saved only to this
    //     copy's own separate storage area and never touches School's data.
    // This is done by replacing window.localStorage *inside each embedded
    // app's own frame* with a small wrapper: reads fall through to School's
    // real, live value unless this Hostel copy has saved its own version of
    // that same item, in which case its own saved version is used instead.
    const HOSTEL_SHIM_STUDENT_KEYS = ['students-list','students-list-meta'];
    const HOSTEL_STORAGE_SHIM_SRC = "(function(){try{var REAL=window.localStorage;if(!REAL)return;window.__HOSTEL_REAL_LOCALSTORAGE__=REAL;var PREFIX='__hostel_override__::';var TOMBSTONE='__HOSTEL_DELETED__';var STUDENT_KEYS={\"students-list\":1,\"students-list-meta\":1};function ovKey(k){return PREFIX+k;}function isStudentKey(k){return !!STUDENT_KEYS[k];}var shim={getItem:function(k){if(isStudentKey(k))return REAL.getItem(k);var ov=REAL.getItem(ovKey(k));if(ov!==null){return ov===TOMBSTONE?null:ov;}return REAL.getItem(k);},setItem:function(k,v){if(isStudentKey(k))return;REAL.setItem(ovKey(k),String(v));},removeItem:function(k){if(isStudentKey(k))return;REAL.setItem(ovKey(k),TOMBSTONE);},clear:function(){for(var i=REAL.length-1;i>=0;i--){var rk=REAL.key(i);if(rk&&rk.indexOf(PREFIX)===0)REAL.removeItem(rk);}},key:function(i){return REAL.key(i);}};Object.defineProperty(shim,'length',{get:function(){return REAL.length;}});Object.defineProperty(window,'localStorage',{value:shim,configurable:true});}catch(e){}})();";

    function injectHostelStorageShim(html) {
      const shimTag = '<script>' + HOSTEL_STORAGE_SHIM_SRC + '<' + '/script>';
      if (/<head[^>]*>/i.test(html)) {
        return html.replace(/<head[^>]*>/i, function(m){ return m + shimTag; });
      }
      return shimTag + html;
    }


    function injectHostelRegisterReadOnly(html) {
      const guard = `<script id="hostel-register-readonly-guard">
(function(){
  'use strict';
  window.__HOSTEL_REGISTER_READONLY__ = true;

  function lockUI(){
    document.querySelectorAll('.tab-btn').forEach(btn => {
      if(btn.dataset.tab === 'add'){
        btn.disabled = true;
        btn.title = 'Student records are read-only in Hostel. Add students in School.';
        btn.style.opacity = '.45';
        btn.style.cursor = 'not-allowed';
        btn.style.pointerEvents = 'none';
      }
    });

    const addPanel = document.getElementById('panel-add');
    if(addPanel){
      addPanel.style.display = 'none';
      addPanel.setAttribute('aria-hidden','true');
    }

    document.querySelectorAll('.edit-btn,.tc-issue-btn,.no-promote-btn,.delete-btn').forEach(btn => {
      btn.disabled = true;
      btn.style.pointerEvents = 'none';
      btn.style.opacity = '.45';
      btn.title = 'Student records are read-only in Hostel. Make changes in School.';
    });

    ['primaryActionBtn','importBtn','clearAllBtn','confirmSaveBtn'].forEach(id => {
      const el = document.getElementById(id);
      if(el) el.disabled = true;
    });

    const noteId = 'hostel-readonly-student-note';
    if(!document.getElementById(noteId)){
      const note = document.createElement('div');
      note.id = noteId;
      note.textContent = 'Student details are linked to School and are read-only here. Add or edit students in the School app.';
      note.style.cssText = 'margin:0 0 14px;padding:9px 12px;border:1px solid #cbd5e1;border-radius:6px;background:#f8fafc;color:#475569;font-size:13px;';
      const recordsPanel = document.getElementById('panel-records');
      if(recordsPanel) recordsPanel.insertBefore(note, recordsPanel.firstChild);
    }
  }

  document.addEventListener('click', function(e){
    const el = e.target && e.target.closest ? e.target.closest('button,[onclick]') : null;
    if(!el) return;
    const onclick = el.getAttribute('onclick') || '';
    if(el.classList.contains('hostel-use-delete-btn')) return;
    if(el.classList.contains('edit-btn') ||
       el.classList.contains('tc-issue-btn') ||
       el.classList.contains('no-promote-btn') ||
       /delete|openConfirm|confirmSave|revokeTc|toggleTcSection|toggleNoPromoteSection|saveNoPromoteHold|clearNoPromoteHold/i.test(onclick)){
      e.preventDefault();
      e.stopImmediatePropagation();
      return false;
    }
  }, true);

  const originalSwitchTab = window.switchTab;
  if(typeof originalSwitchTab === 'function'){
    window.switchTab = function(tab){
      if(tab === 'add') tab = 'records';
      return originalSwitchTab.call(this, tab);
    };
  }

  window.addEventListener('DOMContentLoaded', lockUI);
  setTimeout(lockUI, 0);
  setTimeout(lockUI, 250);
  setTimeout(lockUI, 1000);
})();
<\/script>`;
      return html.replace(/<head[^>]*>/i, function(m){ return m + guard; });
    }

    // The embedded apps are stored gzip-compressed (data-enc="gzip-b64") so
    // this file stays small; they are unpacked here, in the browser, before
    // being opened. Blocks without data-enc are plain base64 as before.
    async function appSourceHtml(el) {
      const b64 = el.textContent.trim();
      if (el.getAttribute('data-enc') !== 'gzip-b64') return b64ToUtf8(b64);
      if (typeof DecompressionStream === 'undefined') {
        throw new Error('This browser cannot open the compressed app data. Please update your browser (Chrome/Edge 80+, Firefox 113+, Safari 16.4+).');
      }
      const binary = atob(b64);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
      return await new Response(stream).text();
    }


    /* The apps run inside an iframe, but when "Save as PDF" is chosen the browser names the file after the
       TOP page's title. This script (added to every app) copies the app's title to the hub page while printing
       and puts the hub's own title back afterwards. */
    function injectPrintTitleBridge(html) {
      const hubTitle = JSON.stringify(document.title).replace(/</g, '\\u003c');
      const script = '<script>(function(){var HUB=' + hubTitle + ',BASE=null,P=window.parent;' +
        'function up(t){try{P.document.title=t||HUB;}catch(e){}}' +
        'var d0=Object.getOwnPropertyDescriptor(Document.prototype,"title");' +
        'try{var d=d0;' +
        'Object.defineProperty(document,"title",{configurable:true,get:function(){return d.get.call(document);},' +
        'set:function(v){d.set.call(document,v);up(v===BASE?HUB:v);}});}catch(e){}' +
        'document.addEventListener("DOMContentLoaded",function(){BASE=d0.get.call(document);});' +
        'window.addEventListener("beforeprint",function(){up(document.title);});' +
        'window.addEventListener("afterprint",function(){up(HUB);});})();<\/script>';
      return html.replace(/<head[^>]*>/i, function (m) { return m + script; });
    }


    /* Receipt numbers are now SAIIER/2026-27/01 (School) and MBC/2026-27/01 (Hostel): 2 digits, growing to 3+ after 99.
       This runs at the very start of the Receipt and Ledger apps (before they read their data) and rewrites any
       saved old-style numbers (SAIIER/2026-27/0007 -> SAIIER/2026-27/07) in the receipts list and in the ledger's
       receipt entries. It is safe to run repeatedly, only touches this hub's own prefix, and only saves when something changed. */
    function receiptNoMigration(PFX) {
      try {
        var LS = window.localStorage, re = new RegExp('^' + PFX + '\\/(\\d{4}-\\d{2})\\/(\\d+)$');
        function norm(v) {
          if (typeof v !== 'string') return v;
          var m = re.exec(v.trim()); if (!m) return v;
          var n = parseInt(m[2], 10);
          return PFX + '/' + m[1] + '/' + (n < 10 ? '0' + n : String(n));
        }
        function fix(key, walk) {
          var raw = LS.getItem(key); if (!raw) return;
          var data; try { data = JSON.parse(raw); } catch (e) { return; }
          if (Array.isArray(data) && walk(data)) LS.setItem(key, JSON.stringify(data));
        }
        fix('sai_receipt_records', function (arr) {
          var c = false;
          arr.forEach(function (r) { if (r && typeof r.slNo === 'string') { var n = norm(r.slNo); if (n !== r.slNo) { r.slNo = n; c = true; } } });
          return c;
        });
        fix('students-ledger-data', function (arr) {
          var c = false;
          arr.forEach(function (st) {
            if (!st || !Array.isArray(st.receipts)) return;
            st.receipts.forEach(function (r) { if (r && typeof r.receiptNo === 'string') { var n = norm(r.receiptNo); if (n !== r.receiptNo) { r.receiptNo = n; c = true; } } });
          });
          return c;
        });
      } catch (e) {}
    }
    function injectReceiptNoMigration(html, prefix) {
      const script = '<script>(' + receiptNoMigration.toString() + ')(' + JSON.stringify(prefix) + ');<\/script>';
      return html.replace(/<head[^>]*>/i, function (m) { return m + script; });
    }

    async function showApp(key) {
      const el = document.getElementById((UNIVERSE === 'hostel' ? 'src-hostel-' : 'src-') + key);
      if (!el) return;
      let html;
      try {
        html = injectPrintTitleBridge(addSharedPrintWatermark(await appSourceHtml(el)));
        if (key === 'receipt' || key === 'ledger') html = injectReceiptNoMigration(html, UNIVERSE === 'hostel' ? 'MBC' : 'SAIIER');
      } catch (err) {
        alert(err && err.message ? err.message : String(err));
        return;
      }
      if (UNIVERSE === 'hostel') {
        html = injectHostelStorageShim(html);
        if (key === 'register') html = injectHostelRegisterReadOnly(html);
      }
      const frame = document.getElementById('app-frame');
      frame.srcdoc = html;
      document.getElementById('home-page').style.display = 'none';
      document.getElementById('universe-fab').style.display = 'none';
      document.getElementById('app-frame-container').style.display = 'block';
      window.scrollTo(0, 0);
    }

    function goHome() {
      document.getElementById('app-frame-container').style.display = 'none';
      document.getElementById('home-page').style.display = 'flex';
      document.getElementById('universe-fab').style.display = 'flex';
      document.getElementById('app-frame').srcdoc = 'about:blank';
    }

    window.addEventListener('message', function(e) {
      if (!e.data || e.data.type !== 'nav-app-hub') return;
      const target = e.data.target;
      if (target === 'home') goHome();
      else showApp(target);
    });

    // ---------------------------------------------------------------
    // Unified hub backup / restore. All embedded apps (receipt,
    // ledger, register) run in a srcdoc iframe that shares this
    // page's origin, so they all read/write the SAME localStorage.
    // Backing up every localStorage key/value in one JSON file (and
    // restoring by writing them all back) covers every app's data in
    // a single step, replacing the need to use each app's own
    // separate JSON backup button one at a time.
    // ---------------------------------------------------------------
    function backupAllData() {
      try {
        const data = {};
        for (let i = 0; i < window.localStorage.length; i++) {
          const key = window.localStorage.key(i);
          data[key] = window.localStorage.getItem(key);
        }
        const payload = {
          __hubBackup: UNIVERSE,
          exportedAt: new Date().toISOString(),
          data: data
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const stamp = new Date().toISOString().slice(0, 10);
        const a = document.createElement('a');
        a.href = url;
        a.download = (UNIVERSE === 'hostel' ? 'Hostel_Hub_Backup_' : 'School_Hub_Backup_') + stamp + '.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 4000);
      } catch (err) {
        alert('Backup failed: ' + err.message);
      }
    }

    function triggerRestoreAllData() {
      const input = document.getElementById('hubRestoreUpload');
      if (input) input.click();
    }

    function handleHubRestoreFile(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        let parsed;
        try {
          parsed = JSON.parse(e.target.result);
        } catch (err) {
          alert('This file is not a valid backup — it could not be read as JSON.');
          event.target.value = '';
          return;
        }
        const dataObj = (parsed && parsed.data && typeof parsed.data === 'object' && !Array.isArray(parsed.data))
          ? parsed.data
          : (parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : null);
        if (!dataObj) {
          alert('This file does not look like a valid hub backup.');
          event.target.value = '';
          return;
        }
        const keyCount = Object.keys(dataObj).length;
        const proceed = window.confirm(
          'This will replace ALL current data in every app on this hub (' + keyCount + ' item(s) in the backup) with the contents of this file.\n\nThis cannot be undone. Continue?'
        );
        event.target.value = '';
        if (!proceed) return;
        try {
          window.localStorage.clear();
          Object.keys(dataObj).forEach(key => {
            window.localStorage.setItem(key, dataObj[key]);
          });
          alert('Restore complete. The hub will now reload.');
          location.reload();
        } catch (err) {
          alert('Restore failed: ' + err.message);
        }
      };
      reader.readAsText(file);
    }

    // ---------------------------------------------------------------------
    // PARALLEL UNIVERSES: School Hub  <->  Hostel Hub
    // One floating button flips the whole home page between the two hubs.
    // The School and Hostel apps are both embedded in this single file.
    // ---------------------------------------------------------------------
    const UNIVERSES = {
      school: {
        title: 'School Office Apps',
        cards: [
          { key: 'receipt',  icon: '\u{1F9FE}', title: 'Cash Receipt Generator',     desc: 'Generate and manage cash receipts, export by month or financial year.' },
          { key: 'ledger',   icon: '\u{1F4D2}', title: 'Student Ledger',             desc: 'Track student fee ledgers, payments and outstanding balances.' },
          { key: 'register', icon: '\u{1F4CB}', title: 'School Student Register', desc: 'Maintain the student admission register, marks and records.' }
        ],
        fabIcon: '\u{1F3E0}', fabLabel: 'Switch to Hostel Hub'
      },
      hostel: {
        title: 'Hostel Hub Apps',
        cards: [
          { key: 'receipt',  icon: '\u{1F9FE}', title: 'Hostel Receipts',            desc: 'Generate and manage cash receipts, export by month or financial year.' },
          { key: 'ledger',   icon: '\u{1F4D2}', title: 'Hostel ledger',              desc: 'Track student fee ledgers, payments and outstanding balances.' },
          { key: 'register', icon: '\u{1F4CB}', title: 'Hostel Register', desc: 'Maintain the student admission register, marks and records.' }
        ],
        fabIcon: '\u{1F3EB}', fabLabel: 'Switch to School Hub'
      }
    };

    let UNIVERSE = 'school';
    try {
      const saved = window.sessionStorage.getItem('__hub_universe');
      if (saved === 'school' || saved === 'hostel') UNIVERSE = saved;
    } catch (e) {}

    function renderUniverse() {
      const u = UNIVERSES[UNIVERSE];
      document.body.setAttribute('data-universe', UNIVERSE);
      document.title = u.title;
      document.querySelector('#home-page h1').textContent = u.title;
      document.querySelector('.app-cards').innerHTML = u.cards.map(function(c) {
        return '<button class="app-card" onclick="showApp(\'' + c.key + '\')">' +
          '<div class="app-card-icon">' + c.icon + '</div>' +
          '<div class="app-card-title">' + c.title + '</div>' +
          '<div class="app-card-desc">' + c.desc + '</div></button>';
      }).join('');
      const fab = document.getElementById('universe-fab');
      fab.textContent = u.fabIcon;
      fab.setAttribute('aria-label', u.fabLabel);
      if (UNIVERSE === 'school') {
        // School side: icon only, no hover note
        fab.removeAttribute('title');
        fab.removeAttribute('data-label');
      } else {
        fab.setAttribute('title', u.fabLabel);
        fab.setAttribute('data-label', u.fabLabel);
      }
    }

    let universeFlipping = false;
    function flipUniverse() {
      if (universeFlipping) return;
      const page = document.getElementById('home-page');
      const swap = function() {
        UNIVERSE = (UNIVERSE === 'school') ? 'hostel' : 'school';
        try { window.sessionStorage.setItem('__hub_universe', UNIVERSE); } catch (e) {}
        renderUniverse();
      };
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { swap(); return; }
      universeFlipping = true;
      const persp = 'perspective(1400px) ';
      page.style.transition = 'transform .28s ease-in';
      page.style.transform = persp + 'rotateY(90deg)';
      setTimeout(function() {
        swap();
        page.style.transition = 'none';
        page.style.transform = persp + 'rotateY(-90deg)';
        void page.offsetWidth;
        page.style.transition = 'transform .28s ease-out';
        page.style.transform = persp + 'rotateY(0deg)';
        setTimeout(function() {
          page.style.transition = '';
          page.style.transform = '';
          universeFlipping = false;
        }, 300);
      }, 280);
    }

    renderUniverse();
  </script>
<script id="monthly-latest-month-autoselect">
(function () {
  const MONTH_ORDER = {
    july: 0, jul: 0,
    august: 1, aug: 1,
    september: 2, sept: 2, sep: 2,
    october: 3, oct: 3,
    november: 4, nov: 4,
    december: 5, dec: 5,
    january: 6, jan: 6,
    february: 7, feb: 7
  };

  function monthRank(value) {
    const s = String(value || '').trim().toLowerCase();
    for (const key in MONTH_ORDER) {
      if (s === key || s.includes(key)) return MONTH_ORDER[key];
    }
    return -1;
  }

  function selectLatestMonth() {
    // Find month selectors by id/name/text rather than assuming one exact id.
    const selects = Array.from(document.querySelectorAll('select')).filter(sel => {
      const meta = [
        sel.id, sel.name, sel.className,
        sel.getAttribute('aria-label'),
        sel.getAttribute('title')
      ].join(' ').toLowerCase();
      return meta.includes('month') || Array.from(sel.options).some(o =>
        monthRank(o.textContent) >= 0
      );
    });

    selects.forEach(sel => {
      const candidates = Array.from(sel.options)
        .map((o, i) => ({
          option: o,
          index: i,
          rank: monthRank(o.textContent || o.value)
        }))
        .filter(x => x.rank >= 0 && !x.option.disabled);

      if (!candidates.length) return;

      const latest = candidates.reduce((a, b) => b.rank > a.rank ? b : a);
      sel.value = latest.option.value;
      latest.option.selected = true;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      sel.dispatchEvent(new Event('input', { bubbles: true }));
    });
  }

  // Run after the page and any existing month-import initialization.
  window.addEventListener('load', () => {
    setTimeout(selectLatestMonth, 100);
    setTimeout(selectLatestMonth, 500);
    setTimeout(selectLatestMonth, 1200);
  });

  // Also expose a safe helper for dynamically rendered month dialogs.
  window.selectLatestMonthlyReportMonth = selectLatestMonth;

  // Watch for dynamically created month selection controls.
  const observer = new MutationObserver(() => {
    if (document.querySelector('select')) {
      clearTimeout(observer._timer);
      observer._timer = setTimeout(selectLatestMonth, 150);
    }
  });
  observer.observe(document.documentElement, { childList: true, subtree: true });
})();
</script>

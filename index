<script id="hub-auto-backup">
/* Auto backup of the WHOLE hub (School + Hostel, every app) every TUESDAY and SATURDAY.
   - On a Tuesday/Saturday the first time the hub is open, a backup is taken. If the hub was not opened on
     that day, the backup is taken the next time it is opened (catch-up). Also re-checked while the hub stays open.
   - Saves a downloadable JSON file AND keeps the latest 12 copies inside this browser (for one-click restore).
   - The backup file has the same format as "Backup All Data", so either Restore button can read it. */
(function () {
  var META = '__hub_autobackup_last__', PREFIX = '__hub_autobackup', DB_NAME = 'school_hostel_hub_autobackups',
      STORE = 'snaps', KEEP = 12, DUE_DAYS = [2, 6]; /* JS weekdays: 2 = Tuesday, 6 = Saturday */

  function ymd(d) { var m = d.getMonth() + 1, day = d.getDate(); return d.getFullYear() + '-' + (m < 10 ? '0' : '') + m + '-' + (day < 10 ? '0' : '') + day; }
  function dayNum(s) { var p = s.split('-'); return Math.round(Date.UTC(+p[0], +p[1] - 1, +p[2]) / 864e5); }
  function addDays(s, n) { var t = new Date(Date.UTC(+s.slice(0, 4), +s.slice(5, 7) - 1, +s.slice(8, 10)) + n * 864e5); return t.toISOString().slice(0, 10); }
  /* Most recent scheduled backup day (Tue/Sat) that is today or earlier, as YYYY-MM-DD. */
  function lastDue(now) {
    var d = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    for (var i = 0; i < 7; i++) {
      if (DUE_DAYS.indexOf(d.getDay()) !== -1) return ymd(d);
      d.setDate(d.getDate() - 1);
    }
    return ymd(now);
  }
  /* The next scheduled day strictly after today. */
  function nextDue(now) {
    var d = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    for (var i = 0; i < 7; i++) {
      d.setDate(d.getDate() + 1);
      if (DUE_DAYS.indexOf(d.getDay()) !== -1) return ymd(d);
    }
    return ymd(d);
  }
  function isDue(now, last) { return !last || last < lastDue(now); }
  function getLast() { try { var v = localStorage.getItem(META); return /^\d{4}-\d{2}-\d{2}$/.test(v || '') ? v : null; } catch (e) { return null; } }

  function collect() {
    var data = {}, n = 0;
    for (var i = 0; i < localStorage.length; i++) {
      var k = localStorage.key(i);
      if (k.indexOf(PREFIX) === 0) continue;
      data[k] = localStorage.getItem(k); n++;
    }
    return { data: data, count: n };
  }

  function openDb() {
    return new Promise(function (res, rej) {
      if (!window.indexedDB) return rej(new Error('no indexedDB'));
      var rq = indexedDB.open(DB_NAME, 1);
      rq.onupgradeneeded = function () { rq.result.createObjectStore(STORE, { keyPath: 'date' }); };
      rq.onsuccess = function () { res(rq.result); };
      rq.onerror = function () { rej(rq.error); };
    });
  }
  function idbSave(date, json) {
    return openDb().then(function (db) {
      return new Promise(function (res, rej) {
        var tx = db.transaction(STORE, 'readwrite'), st = tx.objectStore(STORE);
        st.put({ date: date, json: json });
        var kq = st.getAllKeys();
        kq.onsuccess = function () {
          var keys = kq.result.slice().sort();
          while (keys.length > KEEP) st.delete(keys.shift());
        };
        tx.oncomplete = function () { db.close(); res(); };
        tx.onerror = tx.onabort = function () { db.close(); rej(tx.error); };
      });
    });
  }
  function idbLatest() {
    return openDb().then(function (db) {
      return new Promise(function (res, rej) {
        var rq = db.transaction(STORE, 'readonly').objectStore(STORE).getAll();
        rq.onsuccess = function () { db.close(); var a = rq.result.sort(function (x, y) { return x.date < y.date ? -1 : 1; }); res(a.length ? a[a.length - 1] : null); };
        rq.onerror = function () { db.close(); rej(rq.error); };
      });
    });
  }
  function downloadFile(date, json) {
    var url = URL.createObjectURL(new Blob([json], { type: 'application/json' }));
    var a = document.createElement('a');
    a.href = url; a.download = 'School_Hostel_Hub_AutoBackup_' + date + '.json';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
  }
  function toast(msg) {
    var t = document.getElementById('hub-autobackup-toast');
    if (!t) { t = document.createElement('div'); t.id = 'hub-autobackup-toast'; document.body.appendChild(t); }
    t.textContent = msg; t.style.display = 'block';
    setTimeout(function () { t.style.display = 'none'; }, 6000);
  }
  function showStatus() {
    var el = document.getElementById('autoBackupStatus'); if (!el) return;
    var last = getLast();
    el.textContent = 'Auto backup (every Tuesday & Saturday): ' + (last ? 'last taken ' + last : 'not taken yet');
    var a = document.createElement('a'); a.textContent = 'Restore latest auto backup';
    a.onclick = restoreLatest; el.appendChild(document.createTextNode(' \u00b7 ')); el.appendChild(a);
  }

  function restoreLatest() {
    idbLatest().then(function (snap) {
      if (!snap) return alert('No auto backup is stored in this browser yet.');
      var obj; try { obj = JSON.parse(snap.json); } catch (e) { return alert('The stored auto backup could not be read.'); }
      var data = obj && obj.data; if (!data) return alert('The stored auto backup could not be read.');
      if (!window.confirm('This will replace ALL current data in every app on this hub (School and Hostel) with the auto backup from ' + snap.date + ' (' + Object.keys(data).length + ' items).\n\nThis cannot be undone. Continue?')) return;
      localStorage.clear();
      Object.keys(data).forEach(function (k) { localStorage.setItem(k, data[k]); });
      alert('Restore complete. The hub will now reload.'); location.reload();
    }).catch(function (e) { alert('Restore failed: ' + (e && e.message)); });
  }

  var running = false;
  function run() {
    if (running) return;
    try {
      var now = new Date(), today = ymd(now), last = getLast();
      if (!isDue(now, last)) return showStatus();
      running = true;
      var c = collect();
      if (!c.count) { running = false; return showStatus(); }   // nothing saved yet, nothing to back up
      var json = JSON.stringify({ __hubBackup: 'auto', exportedAt: new Date().toISOString(), data: c.data });
      var okIdb = false, okFile = false;
      idbSave(today, json).then(function () { okIdb = true; }, function () {}).then(function () {
        try { downloadFile(today, json); okFile = true; } catch (e) {}
        if (okIdb || okFile) {
          try { localStorage.setItem(META, today); } catch (e) {}
          toast('Auto backup taken' + (okFile ? ' \u2014 file saved to your Downloads folder.' : '.'));
        }
        running = false;
        showStatus();
      });
    } catch (e) { running = false; showStatus(); }
  }
  window.addEventListener('load', function () { showStatus(); setTimeout(run, 2000); });
  /* Hub left open across days: re-check when the tab is focused again and every 30 minutes. */
  document.addEventListener('visibilitychange', function () { if (!document.hidden) run(); });
  setInterval(run, 30 * 60 * 1000);
})();
</script>
<script id="hub-receipt-number-format">
/* Receipt numbers are SAIIER/<FY>/NN (School) and MBC/<FY>/NN (Hostel): two digits, growing past 99 on their own.
   Receipts saved earlier with 4 digits (e.g. SAIIER/2026-27/0012) are converted here, wherever they are stored
   (receipt records, ledger entries, Hostel copies), before any app opens. Running it again changes nothing.
   The previous text of every changed item is kept once, under "hub_receipt_numbers_premigration_backup". */
(function () {
  var RE = /\b(SAIIER|MBC)\/(\d{4}-\d{2})\/(\d+)\b/g, SAFE = 'hub_receipt_numbers_premigration_backup';
  function fix(str) {
    return str.replace(RE, function (m, p, fy, n) {
      var v = String(parseInt(n, 10)); if (v.length < 2) v = '0' + v;
      return p + '/' + fy + '/' + v;
    });
  }
  function migrate() {
    var changedOld = {}, count = 0, keys = [], i;
    try { for (i = 0; i < localStorage.length; i++) keys.push(localStorage.key(i)); } catch (e) { return 0; }
    keys.forEach(function (k) {
      if (k === SAFE) return;
      var v; try { v = localStorage.getItem(k); } catch (e) { return; }
      if (!v || v.indexOf('/') === -1 || !/(SAIIER|MBC)\//.test(v)) return;
      var nv = fix(v); if (nv === v) return;
      changedOld[k] = v; count++;
    });
    if (!count) return 0;
    try { if (localStorage.getItem(SAFE) === null) localStorage.setItem(SAFE, JSON.stringify({ when: new Date().toISOString(), data: changedOld })); } catch (e) { /* storage full: still convert */ }
    Object.keys(changedOld).forEach(function (k) { try { localStorage.setItem(k, fix(changedOld[k])); } catch (e) {} });
    return count;
  }
  window.__hubReceiptFormat = { migrate: migrate, fix: fix };
  migrate();
})();
</script>
<script id="hub-birthday-popup">
/* Hub-level "Birthdays Today" reminder (School and Hostel).
   The Admission Register has its own birthday popup, but it only runs while the Register app is open
   (the hub loads each app only when its card is clicked, and unloads it on Home), so on the hub's home
   screen nothing appeared. This reminder runs from the hub itself:
   - shows when the hub file is opened, then again at 9:00 AM and 12:00 PM while the hub stays open
     (the Register's own automatic popup is switched off);
   - only between 6 AM and 6 PM, and only when at least one currently enrolled student has a birthday today;
   - uses the same student list and the same "currently enrolled" rule as the Register's popup;
   - stays quiet while the Register app itself is on screen (it shows its own popup there). */
(function () {
  var STUDENT_KEY = 'students-list', HOURS = [9, 12], START_HOUR = 6, END_HOUR = 18;
  var shownSlot = null;
  var MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  function pad2(n) { return (n < 10 ? '0' : '') + n; }
  function ymd(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function monIdx(s) { for (var i = 0; i < 12; i++) if (MON[i].toLowerCase() === String(s).toLowerCase()) return i; return -1; }
  function centuryFromTwoDigits(yy) { var pivot = (new Date().getFullYear() % 100) + 10; return yy <= pivot ? 2000 + yy : 1900 + yy; }
  function mk(y, m, d) { var x = new Date(y, m, d); return (x.getFullYear() === y && x.getMonth() === m && x.getDate() === d) ? x : null; }

  /* Same date formats the Register accepts for a date of birth. */
  function parseFlexibleDate(str) {
    if (!str) return null;
    var t = String(str).trim(), m;
    if ((m = t.match(/^(\d{2})[-\/]([A-Za-z]{3})[-\/](\d{4})$/))) { var mi = monIdx(m[2]); return mi >= 0 ? mk(+m[3], mi, +m[1]) : null; }
    if ((m = t.match(/^(\d{4})-(\d{2})-(\d{2})$/))) return mk(+m[1], +m[2] - 1, +m[3]);
    if ((m = t.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})$/))) return mk(m[3].length === 2 ? centuryFromTwoDigits(+m[3]) : +m[3], +m[2] - 1, +m[1]);
    return null;
  }
  function parseStoredDate(str) {
    var m = /^(\d{2})-([A-Za-z]{3})-(\d{4})$/.exec(str || ''); if (!m) return null;
    var i = monIdx(m[2]); return i === -1 ? null : new Date(Date.UTC(+m[3], i, +m[1]));
  }
  function acadStart(d) { var y = d.getUTCFullYear(), m = d.getUTCMonth(); return m >= 3 ? y : y - 1; }
  function tcLastYear(r) {
    if (!r.tcIssued) return null;
    if (r.tcAcademicYear != null && r.tcAcademicYear !== '') return Number(r.tcAcademicYear);
    var d = parseStoredDate(r.tcDate); return d ? acadStart(d) : acadStart(new Date());
  }
  function displayDob(s) {
    if (/^\d{2}-[A-Za-z]{3}-\d{4}$/.test(String(s || '').trim())) return String(s).trim();
    var d = parseFlexibleDate(s); return d ? pad2(d.getDate()) + '-' + MON[d.getMonth()] + '-' + d.getFullYear() : String(s || '');
  }
  function todaysBirthdays() {
    var list; try { list = JSON.parse(localStorage.getItem(STUDENT_KEY) || '[]'); } catch (e) { return []; }
    if (!Array.isArray(list)) return [];
    var cur = acadStart(new Date()), now = new Date();
    return list.filter(function (r) { return r && (!r.tcIssued || tcLastYear(r) >= cur); })
      .filter(function (r) { var d = parseFlexibleDate(r.dob); return d && d.getDate() === now.getDate() && d.getMonth() === now.getMonth(); })
      .sort(function (a, b) { return String(a.studentName || '').trim().toLowerCase().localeCompare(String(b.studentName || '').trim().toLowerCase()); });
  }

  function ensureUi() {
    if (document.getElementById('hubBdayOverlay')) return;
    var st = document.createElement('style');
    st.textContent =
      '#hubBdayOverlay{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;z-index:2147483100;padding:16px}' +
      '#hubBdayOverlay.active{display:flex}' +
      '#hubBdayCard{background:#fff;color:#1f2937;border-radius:12px;max-width:448px;width:100%;box-shadow:0 12px 40px rgba(0,0,0,.3);border-top:5px solid #c2410c;max-height:85vh;display:flex;flex-direction:column;font-family:inherit}' +
      'body[data-universe="hostel"] #hubBdayCard{border-top-color:#f59e0b}' +
      '#hubBdayHead{padding:16px 18px 6px;position:relative}' +
      '#hubBdayHead h2{margin:0 0 4px;font-size:19px}' +
      '#hubBdayHead p{margin:0;font-size:13px;color:#6b7280}' +
      '#hubBdayClose{position:absolute;top:8px;right:12px;border:0;background:none;font-size:26px;line-height:1;cursor:pointer;color:#6b7280}' +
      '#hubBdayBody{padding:8px 18px;overflow:auto}' +
      '.hubBdayChip{padding:9px 12px;border:1px solid #e5e7eb;border-radius:8px;margin:6px 0;background:#fafafa;font-weight:600;font-size:14px}' +
      '.hubBdayChip span{display:block;font-weight:400;font-size:12px;color:#6b7280;margin-top:2px}' +
      '#hubBdayFoot{padding:10px 18px 16px;display:flex;gap:8px;justify-content:flex-end}' +
      '#hubBdayFoot button{border:1px solid #d1d5db;background:#fff;border-radius:8px;padding:8px 14px;font-size:13px;cursor:pointer}' +
      '#hubBdayFoot button.primary{background:#c2410c;border-color:#c2410c;color:#fff}' +
      '@media print{#hubBdayOverlay{display:none!important}}';
    document.head.appendChild(st);
    var o = document.createElement('div'); o.id = 'hubBdayOverlay';
    o.innerHTML = '<div id="hubBdayCard" role="dialog" aria-label="Birthdays Today"><div id="hubBdayHead"><button id="hubBdayClose" type="button" aria-label="Close">\u00d7</button><h2>\uD83C\uDF82 Birthdays Today</h2><p id="hubBdaySub"></p></div><div id="hubBdayBody"></div><div id="hubBdayFoot"><button type="button" id="hubBdayOpen" class="primary">Open Admission Register</button><button type="button" id="hubBdayOk">Close</button></div></div>';
    document.body.appendChild(o);
    function close() { o.classList.remove('active'); }
    document.getElementById('hubBdayClose').onclick = close;
    document.getElementById('hubBdayOk').onclick = close;
    o.addEventListener('click', function (e) { if (e.target === o) close(); });
    document.getElementById('hubBdayOpen').onclick = function () { close(); if (typeof showApp === 'function') showApp('register'); };
  }

  function registerOnScreen() {
    var c = document.getElementById('app-frame-container'), f = document.getElementById('app-frame');
    if (!c || !f || c.style.display !== 'block') return false;
    return String(f.srcdoc || '').indexOf('id="birthdayOverlay"') !== -1;
  }
  function studentCount() {
    try { var l = JSON.parse(localStorage.getItem(STUDENT_KEY) || 'null'); return Array.isArray(l) ? l.length : 0; } catch (e) { return 0; }
  }
  /* force = true when the person clicks "Show now": ignores the time window and also reports "no birthdays". */
  function showIfAny(force) {
    if (!force && registerOnScreen()) return;
    var list = todaysBirthdays(); if (!list.length && !force) return;
    ensureUi();
    var n = list.length, now = new Date(), today = pad2(now.getDate()) + '-' + MON[now.getMonth()] + '-' + now.getFullYear();
    document.getElementById('hubBdaySub').textContent = n
      ? n + ' student' + (n === 1 ? '' : 's') + ' with a birthday today (' + today + '):'
      : 'No student currently on the register has a birthday today (' + today + ').';
    document.getElementById('hubBdayBody').innerHTML = list.map(function (r) {
      return '<div class="hubBdayChip">' + (r.studentName ? esc(r.studentName) : '(no name)') + '<span>' + esc(r.studentClass || '') + (r.studentClass ? ' \u2022 ' : '') + esc(displayDob(r.dob)) + '</span></div>';
    }).join('');
    document.getElementById('hubBdayOverlay').classList.add('active');
  }

  function refreshStatus() {
    var el = document.getElementById('hubBdayStatus'); if (!el) return;
    var total = studentCount(), n = total ? todaysBirthdays().length : 0, msg;
    if (!total) msg = 'No student records found in this browser yet';
    else if (n) msg = n + ' birthday' + (n === 1 ? '' : 's') + ' today';
    else msg = 'no birthdays today (' + total + ' students checked)';
    el.textContent = '\uD83C\uDF82 Birthday reminder (on opening, 9 AM and 12 PM): ' + msg + ' \u00b7 ';
    var a = document.createElement('a'); a.textContent = 'Show now';
    a.onclick = function () { showIfAny(true); };
    el.appendChild(a);
  }

  /* One key per time slot of the day: "date@open" (before 9 AM), "date@9", "date@12"; null outside 6 AM-6 PM. */
  function currentSlot(now) {
    var h = now.getHours(); if (h < START_HOUR || h >= END_HOUR) return null;
    var sl = 'open'; HOURS.forEach(function (x) { if (x <= h) sl = x; });
    return ymd(now) + '@' + sl;
  }
  /* Shows on opening, then again when 9:00 AM and 12:00 PM arrive while the hub stays open. */
  function tick() {
    var slot = currentSlot(new Date());
    if (slot && slot !== shownSlot) { shownSlot = slot; showIfAny(); }
    refreshStatus();
  }
  window.__hubBirthday = { tick: tick, todaysBirthdays: todaysBirthdays };
  refreshStatus();
  window.addEventListener('load', function () { setTimeout(tick, 1200); });
  document.addEventListener('visibilitychange', function () { if (!document.hidden) tick(); });
  setInterval(tick, 30000);
})();
</script>
